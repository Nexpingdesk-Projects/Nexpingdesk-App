#!/usr/bin/env bash
# Push protection, client side: a commit that adds a secret is refused here,
# before it exists. scripts/local-ci.sh (pre-push) scans the whole history too.
#
# Enabled by scripts/install-git-hooks.sh (git config core.hooksPath .githooks).
# A false positive: add its fingerprint to .gitleaksignore. Genuinely urgent
# and certain: git commit --no-verify.
set -euo pipefail

version=8.30.1
bin="$(command -v gitleaks || true)"
[ -n "$bin" ] || bin="${XDG_CACHE_HOME:-$HOME/.cache}/local-ci/gitleaks-$version"
if [ ! -x "$bin" ]; then
  echo "pre-commit: gitleaks not found — run scripts/install-git-hooks.sh to fetch it." >&2
  exit 1
fi

if ! "$bin" git --pre-commit --staged --redact --no-banner --log-level error; then
  echo >&2
  echo "✗ Commit blocked: the staged changes contain what looks like a secret (above)." >&2
  echo "  Move it to an untracked .env. False positive? Add the fingerprint to .gitleaksignore." >&2
  exit 1
fi
